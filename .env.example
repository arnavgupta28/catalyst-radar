# Copy to .env (never commit .env). On Databricks these come from the `catalyst` secret scope.

# ---- Mode -------------------------------------------------------------
# mock  = everything simulated (free, offline)
# local = laptop: LM Studio + real free APIs
# live  = Databricks jobs (+ Vercel website)
CATALYST_MODE=mock

# Per-provider overrides (optional; default comes from CATALYST_MODE)
# WEB_PROVIDER=mock|direct|tinyfish
# PRICE_PROVIDER_IN=mock|angelone|yfinance
# PRICE_PROVIDER_US=mock|finnhub
# LLM_PROVIDER=mock|lmstudio|databricks|claude

# ---- Storage ----------------------------------------------------------
# Local dev: SQLite file (default) or the docker-compose Postgres
DATABASE_URL=sqlite:///data/local/catalyst.sqlite
# DATABASE_URL=postgresql+psycopg://catalyst:catalyst@localhost:5432/catalyst

# Databricks Unity Catalog (used by jobs)
CATALYST_CATALOG=catalyst
CATALYST_SCHEMA_PREFIX=

# ---- TinyFish (Search + Fetch only; Agent is not used) ---------------
TINYFISH_API_KEY=

# ---- LLMs ---------------------------------------------------------------
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_TRIAGE_MODEL=qwen3-1.7b
LMSTUDIO_WRITER_MODEL=qwen3-4b
# Databricks Foundation Model APIs (OpenAI-compatible)
DATABRICKS_HOST=https://dbc-8de4d59f-c9f5.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_TRIAGE_MODEL=
DATABRICKS_WRITER_MODEL=
# Optional
ANTHROPIC_API_KEY=

# ---- Prices -------------------------------------------------------------
FINNHUB_API_KEY=
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
